# ChatWave — combined environment template for the repository root.
#
# Two ways to configure ChatWave locally (pick either):
#   1. Per package (documented in the README):
#        cp server/.env.example server/.env   # then set MONGODB_URI + JWT_SECRET
#        cp client/.env.example client/.env   # defaults match the dev server on :5000
#   2. Single file for the server: copy this file to `.env` in the repo root.
#      The server loads `server/.env` first and falls back to the root `.env`
#      (the process environment always wins). Vite does NOT read this file —
#      copy the VITE_* values below into `client/.env`.
#
# Never commit a real `.env`: it is gitignored, this template is not.
# Only VITE_-prefixed client variables reach the browser bundle — never put
# secrets in them.

# ---------------------------------------------------------------------------
# Server — read by server/src/config/env.js (zod-validated at boot)
# ---------------------------------------------------------------------------

# HTTP/Socket.io port. Deployment platforms inject PORT — do not set it there.
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string — always include the database name in the path.
# Special characters in the username/password must be percent-encoded:
# "@" → "%40", ":" → "%3A", "/" → "%2F", "?" → "%3F", "#" → "%23".
MONGODB_URI=mongodb://127.0.0.1:27017/chatwave

# JWT signing secret — use a long random string (32+ characters). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# Token lifetime for newly issued tokens (any jsonwebtoken duration).
JWT_EXPIRES_IN=7d

# Origin(s) allowed by CORS, for Express AND Socket.io. Comma-separated list
# allowed (local dev + deployed client). Exact origin only — scheme + host +
# port, no trailing slash, no path.
CLIENT_URL=http://localhost:5173

# E2EE kill-switch: when "true" the server refuses unencrypted messages and
# registrations without key material. Set to "true" in production.
REQUIRE_E2EE=false

# ---------------------------------------------------------------------------
# Client — Vite only reads `client/.env`; copy these there (never secrets!)
# ---------------------------------------------------------------------------

# Base URL of the REST API — must include the /api prefix.
VITE_API_URL=http://localhost:5000/api

# Origin of the Socket.io server (same server as the API, without /api).
VITE_SOCKET_URL=http://localhost:5000
