# Copy this file to client/.env and adjust the values for your machine.
# Only VITE_-prefixed variables are exposed to the browser bundle.
#
# These two are for LOCAL DEV only (Vite serves the app on :5173 while the API
# runs on :5000, so the app needs absolute URLs). Leave both UNSET on the
# deployed Vercel project: it is a Services project on one domain, where the
# app reaches the API through the relative /api path and the socket through the
# page's own origin — no URL has to be baked into the bundle.

# Base URL of the RedChat API — must include the /api prefix.
VITE_API_URL=http://localhost:5000/api

# Base origin of the Socket.io server (same server as the API, without /api).
VITE_SOCKET_URL=http://localhost:5000
