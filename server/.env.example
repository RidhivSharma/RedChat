# Copy this file to server/.env and fill in real values.
# Note: the server loads server/.env first, then falls back to the repo-root .env.
# Variables already present in the process environment always win.

# Server
PORT=5000
NODE_ENV=development

# Database — include the database name in the path (e.g. /chatwave).
# Special characters in the username/password must be percent-encoded:
# "@" → "%40", ":" → "%3A", "/" → "%2F", "?" → "%3F", "#" → "%23".
MONGODB_URI=mongodb://127.0.0.1:27017/chatwave

# Auth — use a long random string (32+ characters)
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Client origin allowed by CORS
CLIENT_URL=http://localhost:5173

# E2EE kill-switch: when "true" the server refuses unencrypted messages
REQUIRE_E2EE=false
